# Copy to .env. Never commit .env or private data.
# Without a key the UI explicitly runs a deterministic rule workflow.
LLM_API_KEY=
LLM_BASE_URL=https://maas.qianwenaiapi.com/compatible-mode/v1
LLM_MODEL=deepseek-v4.1-flash
LLM_DISABLE_THINKING=true
TOTALSEG_DEVICE=cpu
TASK_TIMEOUT_SECONDS=1800
INFERENCE_TIMEOUT_SECONDS=1800
# Optional PostgreSQL + pgvector. Defaults to embedded file-backed H2.
# DB_URL=jdbc:postgresql://127.0.0.1:5432/medagent
# DB_USER=medagent
# DB_PASSWORD=change-me
VECTOR_ENABLED=false
EMBEDDING_BASE_URL=
EMBEDDING_API_KEY=
EMBEDDING_MODEL=text-embedding-3-small
# Local PostgreSQL + local BGE setup: see README. The setup script fills these fields.
# LOCAL_POSTGRES=true
# EMBEDDING_BASE_URL=http://127.0.0.1:8090
# EMBEDDING_MODEL=BAAI/bge-small-zh-v1.5
